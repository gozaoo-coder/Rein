# 依赖与产物
node_modules/
dist/
*.apk
# 发布时对安装包签出的签名（每次发布重新生成，不入库）
*.apk.sig
*.exe.sig

# Tauri / Rust
src-tauri/target/
src-tauri/gen/schemas/

# Android 工程（gen/android 只入库源码与 gradle 配置；
# 同目录的 .gitignore / app/.gitignore 还有一份细则，这里只做兜底）
src-tauri/gen/android/.gradle/
src-tauri/gen/android/build/
src-tauri/gen/android/local.properties
src-tauri/gen/android/app/build/
src-tauri/gen/android/app/.cxx/
src-tauri/gen/android/app/src/main/jniLibs/

# ZCode 会话本地文件
.zcode/

# Android 签名（密钥库与凭据绝不入库）
src-tauri/rein-release.keystore
src-tauri/gen/android/keystore.properties

# 本地构建脚本
build-arm64.cmd

# 日志与临时文件
*.log
*.local
.DS_Store
Thumbs.db
# Windows 保留名：`curl -o NUL` 在 PowerShell 里会落出真实文件而不是设备
/nul

# 一次性调试探针/截屏脚本与探针产物（定位单个问题时临时写的，不入库）
scripts/probe-*
# 例外：选课链路探测不是一次性探针 —— course-watch.mjs 拉起会话时会指名让它跑这一条
# （窗口开没开、真实响应长什么样都以它为准），会话里没有它就只剩临场 improvisation。
!scripts/probe-course-select.mjs
scripts/*-probe.*
scripts/shots-active.mjs
scripts/shots-immerse-morph.mjs
scripts/shots-program.mjs
scripts/shots/
.captcha.png

# 工作台会话本地状态
.workbuddy/

# CommandCode 本地配置与 taste 学习（设备本地，不入库）
.commandcode/

# 端侧 embedding 的模型与 ONNX Runtime 运行库：体积大且可复现，
# 用 scripts/fetch-embed-model.mjs 与 scripts/fetch-ort-runtime.mjs 拉取，不入库。
src-tauri/resources/models/
src-tauri/resources/ort/

# BodyParts3D 解剖网格（约 76 MB，可复现）：build-anatomy 的输入，
# 用 scripts/fetch-anatomy.mjs 按需拉取；产出 src/assets/muscles/rein/*.svg 入库。
resources/anatomy/meshes/

# exercises-dataset 的下载原件（12.9 MB，可复现）与评审草稿：
# 用 scripts/import-dataset.mjs --src <路径> 生成 scripts/catalog/dataset.mjs（生成物入库）
resources/_dataset/
resources/_review/

# 视觉审查/浏览器自动化本地产物（一次性快照与截图，不入库）
.impeccable/
.tmp-critique/
.playwright-cli/

# 更新签名私钥与发布配置（绝不入库；丢了就再也发不出可用的更新）
src-tauri/keys/
scripts/release/release.config.json
scripts/release/e2e-*.local.*

# 发布产物（构建期中间物，可复现）
dist-release/

# 在线服务：数据目录、管理令牌配置、依赖
server/data/
server/config.json
server/node_modules/
